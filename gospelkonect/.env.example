DATABASE_URL="postgresql://user:password@localhost:5432/gospelkonect?schema=public"
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
CORS_ORIGIN=

# --- Phase 2: Authentication ---
# REQUIRED in production (the app refuses to boot without it).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in SECONDS (15 min). Keep short; refresh tokens renew it.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in SECONDS (7 days). Also the Redis TTL for its key.
REFRESH_TOKEN_TTL_SECONDS=604800
# Failed-login rate limit: N attempts per window before HTTP 429.
LOGIN_MAX_ATTEMPTS=5
# Rate-limit window in SECONDS (900 = 15 minutes).
LOGIN_WINDOW_SECONDS=900
