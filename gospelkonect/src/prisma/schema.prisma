generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  // URL (or path) of the uploaded avatar, e.g. /uploads/avatars/<file>.
  avatar       String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase 9: who may moderate, and whether the account may act at all.
  role            UserRole      @default(USER)
  status          AccountStatus @default(ACTIVE)
  // When a suspension ends (null = until an admin lifts it early).
  suspendedUntil  DateTime?
  suspendedReason String?

  // Phase 9: directed blocks. `blocking` are rows where THIS user did the
  // blocking; `blockedBy` are rows where someone else blocked THIS user.
  blocking Block[] @relation("Blocker")
  blockedBy Block[] @relation("Blocked")

  // Phase 9: reports this user filed (as a reporter).
  reportsFiled Report[] @relation("ReportReporter")

  // Social graph: a one-way edge. `following` are the edges where THIS user is
  // the follower (people they follow); `followers` are the edges where this
  // user is being followed.
  following Follow[] @relation("FollowFollower")
  followers Follow[] @relation("FollowFollowing")
  // Cascade: deleting an account takes its posts with it, so no post can be
  // left pointing at an author that no longer exists.
  posts     Post[]
  // Phase 7: notifications. Two ends of the same edge — the account that
  // RECEIVES them and the account that CAUSED them.
  notifications        Notification[]       @relation("NotificationRecipient")
  actorNotifications   Notification[]       @relation("NotificationActor")
  // Phase 8: every blob the account uploaded — post attachments and the
  // profile picture alike. Cascade so deleting an account takes its files.
  media                Media[]
  // Phase 5: discussion and reactions.
  comments             Comment[]         @relation("CommentAuthor")
  reactions            Reaction[]
}

// What caused a notification. The COMMENT/REPLY/REACTION values belong to
// emitters that arrive with their own phases (comments, reactions); they are
// declared now so adding them later is a code change, not a migration that
// has to be rolled out alongside the feature.
enum NotificationType {
  NEW_FOLLOWER
  MENTION
  COMMENT
  REPLY
  REACTION
}

// One row per (recipient, event). Read state is per recipient, so it lives on
// the row rather than in a separate table — an unread badge is then a single
// indexed count instead of a join.
model Notification {
  id         String           @id @default(uuid())
  // Who it is FOR.
  userId     String
  // Who CAUSED it (always present for follow/mention/comment events).
  actorId    String
  type       NotificationType
  // Polymorphic target: 'post' or 'comment'. Not an FK on purpose — one table
  // points at two entity types — so cleanup on delete is handled in code.
  entityType String?
  entityId   String?
  // null = unread. Set once; never cleared except by an explicit un-read.
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user  User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  // The inbox query: WHERE userId = ? ORDER BY createdAt DESC.
  @@index([userId, createdAt(sort: Desc)])
  // The unread badge: WHERE userId = ? AND readAt IS NULL.
  @@index([userId, readAt])
}

// A post: text content authored by one user. Deliberately media-free for now —
// media arrives later as a separate PostMedia table with an FK to this model,
// which needs no change here.
model Post {
  id        String   @id @default(uuid())
  // @db.Text because TEXT (255) is far too small for a post body.
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Phase 8: attachment slots, ordered by PostMedia.position.
  media  PostMedia[]
  // Phase 5: the conversation and the reactions to it.
  comments  Comment[]
  reactions Reaction[]

  // Drives GET /posts (global feed, newest first).
  @@index([createdAt(sort: Desc)])
  // Drives GET /users/:username/posts — filters by author AND orders by date
  // in one index, so an author's timeline never scans their whole history.
  @@index([authorId, createdAt(sort: Desc)])
}

// What a blob IS, for rendering and for the upload rules (one video may stand
// alone in a post; four images may too).
enum MediaKind {
  IMAGE
  VIDEO
}

// One uploaded blob. The BYTES live in object storage (a Composer bucket in
// dev/prod, the local uploads directory otherwise); this table holds only the
// metadata and the URL that points at them, which is what a post or a profile
// actually needs.
model Media {
  id        String    @id @default(uuid())
  // Who uploaded it. Cascade: deleting the account deletes its blobs too.
  ownerId   String
  kind      MediaKind
  // Declared content type, kept for the file endpoint's Content-Type header.
  mimeType  String
  bytes     Int
  // Storage key, e.g. media/<uuid>.jpg. Derived from the MIME type, never
  // from the client's filename, and unique so a key can be resolved in one
  // lookup.
  key       String    @unique
  createdAt DateTime  @default(now())

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  posts PostMedia[]

  // "My uploads, newest first" (profile media lists, admin views).
  @@index([ownerId, createdAt(sort: Desc)])
}

// A post's attachment list. Two rows can never share a position (the order is
// part of the response) or a (post, media) pair (a blob appears once).
model PostMedia {
  postId   String
  mediaId  String
  // 0-based slot in the post's attachment order.
  position Int

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  // Enforces "position 0, 1, 2…" uniqueness per post at the database level.
  @@unique([postId, position])
  // Reverse lookup when a blob is deleted: is anything still attached?
  @@index([mediaId])
}

// Administrator rights, granted through the ADMIN_USERNAMES env var at boot or
// at login. Ordinary accounts never gain it by registering.
enum UserRole {
  USER
  ADMIN
}

// A suspended account may still read while signed out, but every authenticated
// call (and a fresh login) is refused until the suspension ends.
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

// One directed block between two accounts. Composite key: blocking someone
// twice is impossible, and the index serves "who blocked me".
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// What a report claims. The polymorphic pair (targetType, targetId) points at
// a user, post or comment without an FK, so a target that is later deleted
// leaves a report an admin can still read.
enum ReportTargetType {
  USER
  POST
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  IMPERSONATION
  OTHER
}

// The moderation workflow a report moves through.
enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  // Owner of the reported row, resolved once at report time: the admin list
  // can show "whose content" without joining three tables every time.
  subjectUserId String?
  reason       ReportReason
  details      String?          @db.Text
  status       ReportStatus     @default(PENDING)
  resolution   String?          @db.Text
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // The inbox an admin works through: newest open reports first.
  @@index([status, createdAt])
  // "Every report about this post/user".
  @@index([targetType, targetId])
  @@index([reporterId])
}

// Append-only audit trail of what a moderator did. Deliberately no foreign
// keys: deleting an account must not erase the record that it was moderated.
model ModerationAction {
  id         String   @id @default(uuid())
  adminId    String
  // Dotted verb: user.suspend, user.unsuspend, user.promote, post.delete,
  // comment.delete, report.resolve …
  action     String
  targetType String
  targetId   String
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// How someone reacted to a post. One row per (user, post): reacting again
// REPLACES the type, and the primary key makes a duplicate impossible.
enum ReactionType {
  LIKE
  AMEN
  LOVE
}

model Reaction {
  userId    String
  postId    String
  type      ReactionType
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)

  // "Which posts did I react to" and the per-post count breakdown.
  @@id([userId, postId])
  @@index([postId, type])
}

// A comment on a post, or a reply to another comment (parentId). Replies may
// nest to any depth — the API surfaces parentId so clients can thread them.
model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  // Set when this row is a reply; null for a top-level comment. Cascade, so
  // deleting a thread cannot leave children pointing at a missing parent.
  parentId  String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentThread")

  // One post's conversation in chronological order.
  @@index([postId, createdAt])
  // Counting a thread's replies / deleting a user's comments.
  @@index([parentId])
  @@index([authorId])
}

// One row per directed follow relationship. The composite primary key makes
// a duplicate follow impossible at the database level, so POST /users/:id/follow
// is naturally idempotent.
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  // Who does the following (the actor).
  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  // Who is being followed (the target).
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  // Cascade so deleting a user removes every edge touching it, and no orphan
  // rows remain pointing at a missing account.
  @@id([followerId, followingId])
  // Drives the "who follows this user" lookup (GET /users/:username/followers).
  @@index([followingId])
  // Drives the "who does this user follow" lookup (GET /users/:username/following).
  @@index([followerId])
}
