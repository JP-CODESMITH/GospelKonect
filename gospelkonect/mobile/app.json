{
  "expo": {
    "name": "GospelKonect",
    "slug": "gospelkonect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/GospelKonect_G_logo_transparent.png",
    "scheme": "gospelkonect",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/GospelKonect_G_logo_transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/GospelKonect_G_logo_transparent.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GospelKonect_G_logo_transparent.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
